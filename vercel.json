{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/_vercel",
      "destination": "/_vercel.txt"
    },
    {
      "source": "/hectron-streamer-studio",
      "destination": "/hectron-streamer-studio.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets/).*\\.[a-zA-Z0-9]+)$",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
